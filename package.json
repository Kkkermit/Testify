{
	"name": "testify",
	"version": "2.4.6",
	"private": true,
	"description": "Self-hosted, all-in-one Discord bot in TypeScript: every command works as slash and prefix, with a web dashboard",
	"main": "dist/index.js",
	"license": "MIT",
	"author": "Kkermit (https://github.com/Kkkermit)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kkkermit/Testify.git"
	},
	"bugs": {
		"url": "https://github.com/Kkkermit/Testify/issues"
	},
	"homepage": "https://github.com/Kkkermit/Testify#readme",
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/kkermit"
	},
	"keywords": [
		"discord",
		"discord-bot",
		"discord.js",
		"self-hosted",
		"typescript",
		"slash-commands",
		"prefix-commands",
		"moderation",
		"economy",
		"levelling",
		"music",
		"tickets",
		"giveaways",
		"casino",
		"dashboard",
		"mongodb"
	],
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"audit": "better-npm-audit audit --level high",
		"build": "npm run build:shared && npm run build:bot && npm run build:dashboard",
		"build:bot": "tsup",
		"build:dashboard": "npm run build --workspace dashboard && npm run verify:bundle",
		"build:shared": "npm run build --workspace @testify/shared",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"commands:clear": "tsx scripts/clearCommands.ts",
		"commit": "tsx scripts/commitRunner.ts",
		"dashboard:dev": "npm run dev --workspace dashboard",
		"dashboard:fixtures": "tsx dashboard/fixtures/server.ts",
		"db:wipe": "tsx scripts/wipeDatabase.ts",
		"db:wipe:dev": "tsx scripts/wipeDatabase.ts --dev",
		"dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false --conditions=development src/index.ts",
		"dev:all": "tsx scripts/devAll.ts",
		"config:schema": "tsx scripts/generateConfigSchema.ts",
		"docs:commands": "tsx scripts/generateCommandDocs.ts",
		"i18n:commands": "tsx scripts/commandStrings.ts",
		"docs:images": "tsx scripts/renderDocImages.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "tsx scripts/lintRunner.ts",
		"lint:fix": "tsx scripts/lintRunner.ts --fix",
		"music:setup": "tsx scripts/setupMusic.ts",
		"prepare": "husky && npm run build:shared",
		"secret": "tsx scripts/createSecret.ts",
		"setup": "tsx scripts/setupEnv.ts",
		"start": "node dist/index.js",
		"test": "jest --projects jest.config.ts dashboard/jest.config.ts",
		"test:coverage": "jest --coverage && npm run test:coverage:dashboard",
		"test:coverage:dashboard": "jest --config dashboard/jest.config.ts --coverage",
		"test:watch": "jest --watch",
		"typecheck": "tsc --noEmit && npm run typecheck --workspace @testify/dashboard",
		"verify:bundle": "tsx scripts/verifyBundle.ts"
	},
	"lint-staged": {
		"*.{ts,tsx,mts,cts,js,mjs,cjs}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,html}": [
			"prettier --write"
		]
	},
	"overrides": {
		"glob": "$glob",
		"serialize-javascript": "^7.1.3",
		"brace-expansion": "^5.0.12",
		"js-yaml": "^4.3.2",
		"ajv": {
			"fast-uri": "^3.1.9"
		},
		"undici@^5": "^6.29.1",
		"discord-giveaways": {
			"deepmerge-ts": "^8.0.1"
		},
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^3.15.1"
		},
		"jsdom": "^29.1.1"
	},
	"allowScripts": {
		"@parcel/watcher": true,
		"@swc/core": true,
		"esbuild": true,
		"ffmpeg-static": true,
		"mongodb-memory-server": true,
		"unrs-resolver": true,
		"youtube-dl-exec": true
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.13.0",
		"@discordjs/voice": "0.19.2",
		"@electric-sql/pglite": "0.5.17",
		"@hono/node-server": "2.1.11",
		"@napi-rs/canvas": "1.2.0",
		"@shardlens/client": "1.0.0",
		"@shardlens/collector": "1.2.0",
		"@shardlens/discordjs": "1.1.0",
		"@testify/shared": "*",
		"discord-giveaways": "6.0.1",
		"discord-html-transcripts": "3.2.0",
		"discord.js": "14.28.1",
		"dotenv": "18.0.10",
		"figlet": "1.13.0",
		"gifenc": "1.0.3",
		"glob": "14.0.6",
		"hono": "4.13.21",
		"mathjs": "15.3.0",
		"mongoose": "8.24.11",
		"pino": "10.4.0",
		"pino-pretty": "13.2.0",
		"quickchart-js": "4.0.0",
		"zod": "4.6.7"
	},
	"optionalDependencies": {
		"ffmpeg-static": "5.3.0",
		"youtube-dl-exec": "3.1.19"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@eslint/js": "10.0.1",
		"@swc/core": "1.16.22",
		"@swc/jest": "0.2.39",
		"@types/jest": "30.0.0",
		"@types/node": "24.19.2",
		"@types/prompts": "2.4.9",
		"better-npm-audit": "4.2.1",
		"cross-env": "10.1.0",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.18.1",
		"husky": "9.1.7",
		"jest": "30.5.2",
		"lint-staged": "17.6.2",
		"mongodb-memory-server": "11.4.0",
		"prettier": "3.10.1",
		"prompts": "2.4.2",
		"tsc-alias": "1.9.10",
		"tsup": "9.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.74.0",
		"yaml": "2.9.1"
	},
	"workspaces": [
		"shared",
		"dashboard"
	]
}
