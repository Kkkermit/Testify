{
	"name": "testify",
	"version": "2.0.0",
	"description": "Open source, multipurpose Discord bot written in TypeScript",
	"main": "dist/index.js",
	"license": "MIT",
	"author": "Kkermit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kkkermit/Testify.git"
	},
	"bugs": {
		"url": "https://github.com/Kkkermit/Testify/issues"
	},
	"homepage": "https://github.com/Kkkermit/Testify#readme",
	"keywords": [
		"discord",
		"discord-bot",
		"discord.js",
		"typescript",
		"moderation",
		"economy",
		"music"
	],
	"engines": {
		"node": ">=22.11.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"db:wipe": "tsx scripts/wipeDatabase.ts",
		"env:setup": "tsx scripts/setupEnv.ts",
		"codebase:info": "tsx scripts/linesOfCode.ts",
		"prepare": "husky",
		"docs:commands": "tsx scripts/generateCommandDocs.ts"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"overrides": {
		"glob": "$glob",
		"test-exclude": "^7.0.1",
		"esbuild": "^0.28.1",
		"serialize-javascript": "^7.0.7",
		"spotify-web-api-node": {
			"superagent": "^10.2.3"
		},
		"discord-html-transcripts": {
			"undici": "^6.28.0"
		}
	},
	"dependencies": {
		"@discordjs/voice": "0.19.2",
		"@distube/soundcloud": "2.0.4",
		"@distube/spotify": "2.0.2",
		"@distube/yt-dlp": "2.0.1",
		"@napi-rs/canvas": "1.0.2",
		"@ngrok/ngrok": "1.7.0",
		"discord-giveaways": "6.0.1",
		"discord-html-transcripts": "3.2.0",
		"discord.js": "14.27.0",
		"distube": "5.2.3",
		"dotenv": "17.4.2",
		"express": "5.2.1",
		"ffmpeg-static": "5.2.0",
		"figlet": "1.11.3",
		"glob": "13.0.6",
		"libsodium-wrappers": "0.8.4",
		"mathjs": "15.2.0",
		"mongoose": "8.24.1",
		"opusscript": "0.1.1",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"prompts": "2.4.2",
		"quickchart-js": "4.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@swc/core": "1.15.46",
		"@swc/jest": "0.2.39",
		"@types/express": "5.0.6",
		"@types/figlet": "1.7.0",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/prompts": "2.4.9",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"husky": "9.1.7",
		"jest": "30.4.2",
		"lint-staged": "17.2.0",
		"mongodb-memory-server": "11.2.0",
		"prettier": "3.9.6",
		"tsup": "8.5.1",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.65.0"
	}
}
