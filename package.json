{
	"name": "testify",
	"version": "2.0.0",
	"description": "Open source, multipurpose Discord bot written in TypeScript",
	"main": "dist/index.js",
	"license": "MIT",
	"author": "Kkermit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kkkermit/Testify.git"
	},
	"bugs": {
		"url": "https://github.com/Kkkermit/Testify/issues"
	},
	"homepage": "https://github.com/Kkkermit/Testify#readme",
	"keywords": [
		"discord",
		"discord-bot",
		"discord.js",
		"typescript",
		"moderation",
		"economy"
	],
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"audit": "better-npm-audit audit --level high",
		"build": "npm run build:shared && npm run build:bot && npm run build:dashboard",
		"build:bot": "tsup",
		"build:dashboard": "npm run build --workspace dashboard && npm run verify:bundle",
		"build:shared": "npm run build --workspace @testify/shared",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
		"commands:clear": "tsx scripts/clearCommands.ts",
		"commit": "tsx scripts/commitRunner.ts",
		"dashboard:dev": "npm run dev --workspace dashboard",
		"db:wipe": "tsx scripts/wipeDatabase.ts",
		"dev": "npm run build:shared && cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
		"dev:all": "tsx scripts/devAll.ts",
		"docs:commands": "tsx scripts/generateCommandDocs.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "tsx scripts/lintRunner.ts",
		"lint:fix": "tsx scripts/lintRunner.ts --fix",
		"prepare": "husky && npm run build:shared",
		"secret": "tsx scripts/createSecret.ts",
		"setup": "tsx scripts/setupEnv.ts",
		"start": "node dist/index.js",
		"test": "jest --projects jest.config.ts dashboard/jest.config.ts",
		"test:coverage": "jest --coverage && npm run test:coverage:dashboard",
		"test:coverage:dashboard": "jest --config dashboard/jest.config.ts --coverage",
		"test:watch": "jest --watch",
		"typecheck": "tsc --noEmit && npm run typecheck --workspace @testify/dashboard",
		"verify:bundle": "tsx scripts/verifyBundle.ts"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"overrides": {
		"glob": "$glob",
		"test-exclude": "^7.0.1",
		"esbuild": "^0.28.1",
		"serialize-javascript": "^7.0.7",
		"brace-expansion": "^5.0.9",
		"js-yaml": "^4.3.1",
		"fast-uri": "^3.1.5",
		"discord-html-transcripts": {
			"undici": "^6.28.0"
		},
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^3.15.1"
		}
	},
	"dependencies": {
		"@hono/node-server": "2.0.12",
		"@napi-rs/canvas": "1.0.2",
		"discord-giveaways": "6.0.1",
		"discord-html-transcripts": "3.2.0",
		"discord.js": "14.27.0",
		"dotenv": "17.4.2",
		"figlet": "1.11.3",
		"glob": "13.0.6",
		"hono": "4.13.0",
		"mathjs": "15.2.0",
		"mongoose": "8.24.1",
		"pino": "10.3.1",
		"pino-pretty": "13.1.3",
		"prompts": "2.4.2",
		"quickchart-js": "4.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@eslint/js": "10.0.1",
		"@swc/core": "1.15.46",
		"@swc/jest": "0.2.39",
		"@types/figlet": "1.7.0",
		"@types/jest": "30.0.0",
		"@types/node": "22.20.1",
		"@types/prompts": "2.4.9",
		"better-npm-audit": "3.11.0",
		"cross-env": "10.1.0",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"husky": "9.1.7",
		"jest": "30.4.2",
		"lint-staged": "17.2.0",
		"mongodb-memory-server": "11.2.0",
		"prettier": "3.9.6",
		"tsc-alias": "1.8.16",
		"tsup": "8.5.1",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.65.0"
	},
	"workspaces": [
		"shared",
		"dashboard"
	]
}
