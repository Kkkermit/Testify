{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		// tsc only type-checks here — tsup/esbuild does the emit, so this models
		// "a bundler resolves this" rather than Node's own algorithm. "Node" was
		// deprecated and stops working in TypeScript 7; "Node16" would be right if
		// tsc emitted, but it rejects dual packages that ship one .d.ts (mathjs),
		// which resolves and runs perfectly well under require().
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"rootDir": ".",
		"noEmit": true,

		// No "baseUrl" — deprecated in TypeScript 6, removed in 7. Without it the
		// targets below are relative to this file, hence the leading "./".
		//
		// "@testify/shared" is deliberately NOT here. tsc-alias rewrites everything in
		// this map to a relative path inside dist/, and nothing outside src/ is emitted
		// there — it resolved the package to dist/index.js, the bot's own entry point.
		// Left as a bare specifier it resolves through node_modules like any package.
		"paths": {
			"@core": ["./src/core/index.ts"],
			"@core/*": ["./src/core/*"],
			"@config": ["./src/config/index.ts"],
			"@config/*": ["./src/config/*"],
			"@lib": ["./src/lib/index.ts"],
			"@lib/*": ["./src/lib/*"],
			"@commands/*": ["./src/commands/*"],
			"@events/*": ["./src/events/*"],
			"@buttons/*": ["./src/buttons/*"],
			"@database": ["./src/database/index.ts"],
			"@database/*": ["./src/database/*"],
			"@jobs/*": ["./src/jobs/*"],
			"@root/*": ["./src/*"],
			"@api/*": ["./src/api/*"],
			"@tests/*": ["./tests/*"]
		},

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"useUnknownInCatchVariables": true,

		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"declaration": false,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,

		"types": ["node", "jest"]
	},
	"include": [
		"./src/**/*.ts",
		"./shared/src/**/*.ts",
		"tests/**/*.ts",
		"scripts/**/*.ts",
		"*.config.ts",
		"shared/*.config.ts"
	],
	"exclude": ["node_modules", "dist", "dashboard"]
}
