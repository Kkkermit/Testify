# Copy this file to `.env` and fill it in, or run `npm run setup` to be asked for
# each value. Only the first four are required.
#
# For a separate development bot, copy `.env.development.example` to
# `.env.development` instead — `npm run dev` reads that one.

# Discord Developer Portal → Bot → Token.
# MUST be a different bot from your development one.
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID.
# MUST match the token above.
DISCORD_CLIENT_ID=

# Your Discord user ID. Comma separated if there is more than one owner.
DISCORD_OWNER_IDS=

# A MongoDB connection string, e.g. mongodb://localhost:27017/testify
MONGODB_URI=

# Your test server's ID. Commands appear there instantly instead of taking up to
# an hour to roll out globally. LEAVE BLANK HERE — this is the production file.
DISCORD_DEV_GUILD_ID=

# trace, debug, info, warn, error or fatal. Defaults to info.
LOG_LEVEL=

# Channel IDs for optional logging. Leave any of them blank to turn that log off.
CHANNEL_ERROR_LOG=
CHANNEL_GUILD_LOG=
CHANNEL_DM_LOG=
CHANNEL_FEEDBACK_LOG=
