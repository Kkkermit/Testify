# Copy this file to `.env` and fill it in, or run `npm run setup` to be asked for
# each value. Only the first four are required.
#
# For a separate development bot, copy `.env.development.example` to
# `.env.development` instead — `npm run dev` reads that one.

# Discord Developer Portal → Bot → Token.
# MUST be a different bot from your development one.
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID.
# MUST match the token above.
DISCORD_CLIENT_ID=

# Your Discord user ID. Comma separated if there is more than one owner.
DISCORD_OWNER_IDS=

# A MongoDB connection string, e.g. mongodb://localhost:27017/testify
MONGODB_URI=

# Your test server's ID. Commands appear there instantly instead of taking up to
# an hour to roll out globally. LEAVE BLANK HERE — this is the production file.
DISCORD_DEV_GUILD_ID=

# trace, debug, info, warn, error or fatal. Defaults to info.
LOG_LEVEL=

# Channel IDs for optional logging. Leave any of them blank to turn that log off.
CHANNEL_ERROR_LOG=
CHANNEL_GUILD_LOG=
CHANNEL_DM_LOG=
CHANNEL_FEEDBACK_LOG=

# ─── The web dashboard ────────────────────────────────────────────────────────
# Off unless this says exactly `true`. Everything below is ignored while it is
# off, and the four values under it are required once it is on.
DASHBOARD_ENABLED=

# Discord Developer Portal → OAuth2 → Client Secret. This is not the bot token,
# and it must never reach a browser — the API holds it and nothing else does.
DISCORD_CLIENT_SECRET=

# Where the dashboard is reachable, with no trailing slash. It has to match the
# redirect URI you add in the Developer Portal under OAuth2 → Redirects, which
# is this value plus `/api/auth/callback`.
DASHBOARD_BASE_URL=

# At least 32 characters of randomness. It signs sessions and derives the key
# the Discord tokens are encrypted with, so changing it signs everybody out.
#   npm run secret              prints one
#   npm run secret -- --write   puts one straight into this file
DASHBOARD_SESSION_SECRET=

# Defaults to 8080.
DASHBOARD_PORT=

# Defaults to 127.0.0.1, which means only this machine can reach it. Put a
# reverse proxy with TLS in front rather than changing this to 0.0.0.0.
DASHBOARD_BIND=

# `true` only if a reverse proxy in front of you sets X-Forwarded-For. Trusting
# that header without one lets anybody forge their IP address.
DASHBOARD_TRUST_PROXY=

# How many days an idle sign-in survives. Defaults to 7.
DASHBOARD_SESSION_TTL_DAYS=
