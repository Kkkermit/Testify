# Copy this file to `.env.development` and fill it in, or run `npm run setup -- --dev`.
# `npm run dev` reads this file; `npm start` reads `.env`.
#
# The point of the split is that `npm run dev` must never start the production
# bot. Use a SECOND Discord application here, not the one your users invite.

# Your development bot's token — a different application from production.
DISCORD_TOKEN=

# The development application's ID. MUST match the token above.
DISCORD_CLIENT_ID=

# Your Discord user ID. Comma separated if there is more than one owner.
DISCORD_OWNER_IDS=

# A MongoDB connection string. Point it at a SEPARATE database from production,
# e.g. mongodb://localhost:27017/testify-dev
MONGODB_URI=

# Your test server's ID. Commands appear there instantly instead of taking up to
# an hour to roll out globally. SET THIS in development — it is the whole reason
# a dev bot is quick to iterate on.
DISCORD_DEV_GUILD_ID=

# trace, debug, info, warn, error or fatal. `debug` is the useful one here.
LOG_LEVEL=debug

# Channel IDs for optional logging. Leave any of them blank to turn that log off.
CHANNEL_ERROR_LOG=
CHANNEL_GUILD_LOG=
CHANNEL_DM_LOG=
CHANNEL_FEEDBACK_LOG=

# ─── The web dashboard ────────────────────────────────────────────────────────
# `npm run dev:all` runs the bot and Vite together. Vite serves the page on
# :5174 and proxies /api to DASHBOARD_PORT, so the browser only ever talks to
# one origin and session cookies work with no CORS setup.
DASHBOARD_ENABLED=

# Your DEVELOPMENT application's OAuth2 client secret, not production's.
DISCORD_CLIENT_SECRET=

# Vite's address in development, since that is what the browser is pointed at.
# Add http://localhost:5174/api/auth/callback to the Developer Portal's
# OAuth2 → Redirects for this application.
DASHBOARD_BASE_URL=http://localhost:5174

# Any 32+ characters will do here.
#   npm run secret                     prints one
#   npm run secret -- --write --dev    puts one straight into this file
DASHBOARD_SESSION_SECRET=

# Where the bot's API listens. Vite's proxy points at this.
DASHBOARD_PORT=3000

# Defaults to 127.0.0.1, which is right for development.
DASHBOARD_BIND=

# Leave both blank in development.
DASHBOARD_TRUST_PROXY=
DASHBOARD_SESSION_TTL_DAYS=

# NODE_ENV is deliberately not here. `npm run dev` sets it with cross-env, which is what makes the bot read
# `.env.development` instead of `.env` — setting it in a file would fight that and could start the wrong bot.
