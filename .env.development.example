# Generated by `npm run env:setup`. Every key here is read by src/config/env.ts.

# Development mode
NODE_ENV=development

# Bot token (required)
# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=

# Application (client) ID (required)
DISCORD_CLIENT_ID=

# Owner user IDs (comma separated) (required)
DISCORD_OWNER_IDS=

# MongoDB connection string (required)
MONGODB_URI=

# Development guild ID (instant command updates)
DISCORD_DEV_GUILD_ID=

# Log level (trace/debug/info/warn/error/fatal)
LOG_LEVEL=

# Channel ID for guild-join logs
CHANNEL_GUILD_JOIN_LOG=

# Channel ID for guild-leave logs
CHANNEL_GUILD_LEAVE_LOG=

# Channel ID for command errors
CHANNEL_COMMAND_ERROR_LOG=

# Channel ID for eval logs
CHANNEL_EVAL_LOG=

# Channel ID for direct-message logs
CHANNEL_DM_LOG=

# Webhook URL for slash command logging
WEBHOOK_SLASH_LOGGING=

# Webhook URL for prefix command logging
WEBHOOK_PREFIX_LOGGING=

# Webhook URL for bug reports
WEBHOOK_BUG_REPORTS=

# Webhook URL for suggestions
WEBHOOK_SUGGESTIONS=

# Webhook URL mirroring warnings and errors
WEBHOOK_CONSOLE_LOGGING=

# TMDB API key (film lookups)
TMDB_API_KEY=

# RapidAPI key
RAPID_API_KEY=

# Clash Royale API key
CLASH_ROYALE_API_KEY=

# Spotify client ID
SPOTIFY_CLIENT_ID=

# Spotify client secret
SPOTIFY_CLIENT_SECRET=

# Spotify redirect URI
SPOTIFY_REDIRECT_URI=

# Port for the OAuth callback server
OAUTH_PORT=

# OAuth state signing secret (leave blank to generate)
OAUTH_STATE_SECRET=

# 32-byte hex key for encrypting third-party tokens (leave blank to generate)
TOKEN_ENCRYPTION_KEY=

# ngrok auth token
NGROK_AUTH_TOKEN=
