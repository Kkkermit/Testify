# Copy this file to `.env.development` and fill it in, or run `npm run setup -- --dev`.
# `npm run dev` reads this file; `npm start` reads `.env`.
#
# The point of the split is that `npm run dev` must never start the production
# bot. Use a SECOND Discord application here, not the one your users invite.

# Your development bot's token — a different application from production.
DISCORD_TOKEN=

# The development application's ID. MUST match the token above.
DISCORD_CLIENT_ID=

# Your Discord user ID. Comma separated if there is more than one owner.
DISCORD_OWNER_IDS=

# A MongoDB connection string. Point it at a SEPARATE database from production,
# e.g. mongodb://localhost:27017/testify-dev
MONGODB_URI=

# Your test server's ID. Commands register there only, so what you are halfway
# through building is not live everywhere. SET THIS in development — it is why
# a dev bot is quick to iterate on.
DISCORD_DEV_GUILD_ID=

# trace, debug, info, warn, error or fatal. `debug` is the useful one here.
LOG_LEVEL=debug

# Channel IDs for optional logging. Leave any of them blank to turn that log off.
# Command failures, with the error and a reference the member can quote.
CHANNEL_ERROR_LOG=
# Servers the bot is added to and removed from.
CHANNEL_GUILD_LOG=
# Direct messages sent to the bot.
CHANNEL_DM_LOG=
# Every slash command run: which one, who ran it, where, and whether it worked.
CHANNEL_SLASH_COMMAND_LOG=
# The same for every prefix command run.
CHANNEL_PREFIX_COMMAND_LOG=
# What members send with /bug-report.
CHANNEL_BUG_REPORT_LOG=
# What members send with /suggest.
CHANNEL_SUGGESTION_LOG=
# Every /eval run with its full code, and anyone other than an owner trying an owner-only command.
# Falls back to CHANNEL_ERROR_LOG when blank.
CHANNEL_EVAL_LOG=

# ─── The web dashboard ────────────────────────────────────────────────────────
# `npm run dev:all` runs the bot and Vite together. Vite serves the page on
# :5174 and proxies /api to DASHBOARD_PORT, so the browser only ever talks to
# one origin and session cookies work with no CORS setup.
DASHBOARD_ENABLED=

# Your DEVELOPMENT application's OAuth2 client secret, not production's.
DISCORD_CLIENT_SECRET=

# Vite's address in development, since that is what the browser is pointed at.
# Add http://localhost:5174/api/auth/callback to the Developer Portal's
# OAuth2 → Redirects for this application.
DASHBOARD_BASE_URL=http://localhost:5174

# Any 32+ characters will do here.
#   npm run secret                     prints one
#   npm run secret -- --write --dev    puts one straight into this file
DASHBOARD_SESSION_SECRET=

# Where the bot's API listens. Vite's proxy points at this.
DASHBOARD_PORT=3000

# Defaults to 127.0.0.1, which is right for development.
DASHBOARD_BIND=

# Leave both blank in development.
DASHBOARD_TRUST_PROXY=
DASHBOARD_SESSION_TTL_DAYS=

# Music. Both are optional: blank means "look on PATH". `npm run music:setup` fetches
# yt-dlp into ./bin and reports whether FFmpeg is there too.
#
# yt-dlp is required for music. FFmpeg is not — without it, tracks that are not
# already in Opus are refused by name rather than played as silence.
MUSIC_YTDLP_PATH=
MUSIC_FFMPEG_PATH=

# YouTube cookies, for a host YouTube has flagged ("Sign in to confirm you're not a bot"), which is
# common on cloud hosts. Optional: leave blank until you see that error.
#
# Export cookies.txt from a browser signed in to YouTube (the yt-dlp FAQ explains how; a spare
# account is safest, since these sign the bot in as that account). Then either give the path to
# the file, or paste the file's contents here, where a real file is awkward (Docker, Railway).
MUSIC_YTDLP_COOKIES=

# Support assistant, behind /ask and the dashboard's Help page. It always answers with one of the
# written help articles in assets/support, never with generated text.
#
# Blank key: it matches questions by search alone, contacts nobody, and costs nothing.
# With an Anthropic API key, Claude picks the article instead, which copes far better with
# questions worded unlike any article. Only the question and the list of articles are sent; the
# key is never logged, and at most 120 questions an hour reach the model before search takes over.
SUPPORT_AI_API_KEY=
# Defaults to claude-opus-5. Any Claude model that supports structured outputs works.
SUPPORT_AI_MODEL=

# NODE_ENV is deliberately not here. `npm run dev` sets it with cross-env, which is what makes the bot read
# `.env.development` instead of `.env` — setting it in a file would fight that and could start the wrong bot.
