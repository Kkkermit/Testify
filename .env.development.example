# Copy this file to `.env.development` and fill it in, or run `npm run setup -- --dev`.
# `npm run dev` reads this file; `npm start` reads `.env`.
#
# The point of the split is that `npm run dev` must never start the production
# bot. Use a SECOND Discord application here, not the one your users invite.
#
# Links, who runs it and the default prefix go in `testify.config.json` beside this
# file, which `npm run dev` and `npm start` both read. See docs/customising.md.

# Your development bot's token — a different application from production.
DISCORD_TOKEN=

# The development application's ID. MUST match the token above.
DISCORD_CLIENT_ID=

# Your Discord user ID. Comma separated if there is more than one owner.
DISCORD_OWNER_IDS=

# A MongoDB connection string. Point it at a SEPARATE database from production,
# e.g. mongodb://localhost:27017/testify-dev
MONGODB_URI=

# Your test server's ID. Commands register there only, so what you are halfway
# through building is not live everywhere. SET THIS in development — it is why
# a dev bot is quick to iterate on.
DISCORD_DEV_GUILD_ID=

# trace, debug, info, warn, error or fatal. `debug` is the useful one here.
LOG_LEVEL=debug

# Features this bot runs without, comma-separated, such as `music,casino`. Their
# commands leave Discord's menu and /help, and their screens leave the dashboard.
# Blank runs every one. The features are music, economy, casino, lottery,
# treasure, levelling, tickets, giveaways, games, fun, modmail, appeals,
# starboard, ideas, temp-voice, birthdays and invites. Casino, lottery and
# treasure need economy, so switching economy off switches them off too.
DISABLED_FEATURES=

# Channel IDs for optional logging. Leave any of them blank to turn that log off.
# Command failures, with the error and a reference the member can quote.
CHANNEL_ERROR_LOG=
# Servers the bot is added to and removed from.
CHANNEL_GUILD_LOG=
# Direct messages sent to the bot.
CHANNEL_DM_LOG=
# Every slash command run: which one, who ran it, where, and whether it worked.
CHANNEL_SLASH_COMMAND_LOG=
# The same for every prefix command run.
CHANNEL_PREFIX_COMMAND_LOG=
# What members send with /bug-report.
CHANNEL_BUG_REPORT_LOG=
# What members send with /suggest.
CHANNEL_SUGGESTION_LOG=
# Every /eval run with its full code, and anyone other than an owner trying an owner-only command.
# Falls back to CHANNEL_ERROR_LOG when blank.
CHANNEL_EVAL_LOG=

# ─── The website ──────────────────────────────────────────────────────────────
# The landing page, the docs and the source browser, served on DASHBOARD_PORT
# and DASHBOARD_BIND below. On unless this says exactly `false`, and it needs
# nothing else. The dashboard adds sign-in and the server screens to it.
SITE_ENABLED=

# Optional, and worth setting on a shared host. Without a token GitHub lets the
# source page make 60 requests an hour from this machine's address, and other
# customers of a shared host can spend them first; with one it has the token's
# own 5,000. A fine-grained token with Administration read on the repository
# also shows its traffic; a classic one needs `repo`.
SITE_GITHUB_TOKEN=

# ─── The web dashboard ────────────────────────────────────────────────────────
# `npm run dev:all` runs the bot and Vite together. Vite serves the page on
# :5174 and proxies /api to DASHBOARD_PORT, so the browser only ever talks to
# one origin and session cookies work with no CORS setup.
DASHBOARD_ENABLED=

# Your DEVELOPMENT application's OAuth2 client secret, not production's.
DISCORD_CLIENT_SECRET=

# Vite's address in development, since that is what the browser is pointed at.
# Add http://localhost:5174/api/auth/callback to the Developer Portal's
# OAuth2 → Redirects for this application.
DASHBOARD_BASE_URL=http://localhost:5174

# Any 32+ characters will do here.
#   npm run secret                     prints one
#   npm run secret -- --write --dev    puts one straight into this file
DASHBOARD_SESSION_SECRET=

# Where the bot's API listens. Vite's proxy points at this.
DASHBOARD_PORT=3000

# Defaults to 127.0.0.1, which is right for development.
DASHBOARD_BIND=

# Leave both blank in development.
DASHBOARD_TRUST_PROXY=
DASHBOARD_SESSION_TTL_DAYS=

# Music. Both are optional: blank means "look on PATH". `npm run music:setup` fetches
# yt-dlp into ./bin and reports whether FFmpeg is there too.
#
# yt-dlp is required for music. FFmpeg is not — without it, tracks that are not
# already in Opus are refused by name rather than played as silence.
MUSIC_YTDLP_PATH=
MUSIC_FFMPEG_PATH=

# Support assistant, behind /ask and the dashboard's Help page. It always answers with one of the
# written help articles in assets/support, never with generated text.
#
# Blank key: it matches questions by search alone, contacts nobody, and costs nothing.
# With an Anthropic API key, Claude picks the article instead, which copes far better with
# questions worded unlike any article. Only the question and the list of articles are sent; the
# key is never logged, and at most 120 questions an hour reach the model before search takes over.
SUPPORT_AI_API_KEY=
# Defaults to claude-opus-5. Any Claude model that supports structured outputs works.
SUPPORT_AI_MODEL=

# Analytics, with Shardlens (https://github.com/Kkkermit/Shardlens). Off while both are blank: nothing is
# attached and nothing is sent. With both set, the bot sends which commands ran, how they ended and how long
# they took, the servers it joins and leaves, and its own REST and shard health to your collector. Never message
# text, and user IDs are hashed inside the bot before anything leaves it. Run a collector with
# `npx shardlens init --domain <your domain> --app-id <your application ID>`.
#
# Both are in the bot.env that command writes. Neither can stop the bot starting: a wrong one is a warning in the
# log, and nothing is sent.
#
# The collector's address. HTTPS, or plain HTTP to localhost only.
SHARDLENS_URL=
# The collector's ingest key, starting slk_ingest_. It can send events and read nothing.
SHARDLENS_INGEST_KEY=
# The collector's read key, starting slk_read_, which the owner console reads its analytics with. The bot keeps it
# and never hands it to a browser. It reads counts and nothing else: it cannot see who ran what.
SHARDLENS_READ_KEY=
# Optional. The collector's activity key, starting slk_activity_, which lets the owner console show who ran what
# when the collector and the bot are both in audit mode. Only the bot's owners see it, and the collector records
# every read in its access log. Blank keeps who ran what on the collector's own dashboard alone. It needs collector
# 1.2 or later (`docker compose pull && docker compose up -d` beside its docker-compose.yml), audit mode on it
# (SHARDLENS_MODE=audit with SHARDLENS_AUDIT_KEY, or Settings → User identity) and a key from its Settings → API
# keys. The console's Usage → Setup says which of those is missing.
SHARDLENS_ACTIVITY_KEY=
# Where `testify.config.json` is, when it is not beside this file: on a Railway volume, say. Blank looks beside
# it, which is what you want almost always; docker-compose.yml sets this itself. The file holds your links, who
# runs your copy and the default prefix — see docs/customising.md.
TESTIFY_CONFIG=

# NODE_ENV is deliberately not here. `npm run dev` sets it with cross-env, which is what makes the bot read
# `.env.development` instead of `.env` — setting it in a file would fight that and could start the wrong bot.
